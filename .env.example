# ============================================================
# Copy to .env and fill in real values. NEVER commit .env (N7).
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME=<PROJECT_NAME>
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=change-me-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
MAX_UPLOAD_MB=5
ALLOWED_CV_EXTENSIONS=pdf,docx

# --- PostgreSQL (app data + LangGraph checkpointer) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=recruitment
POSTGRES_USER=recruit_user
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://recruit_user:change-me@postgres:5432/recruitment
LANGGRAPH_CHECKPOINT_URL=postgresql://recruit_user:change-me@postgres:5432/recruitment

# --- ChromaDB (RAG knowledge base + semantic matching) ---
CHROMA_HOST=chroma
CHROMA_PORT=8000
CHROMA_COLLECTION_TECH_DOCS=verified_tech_docs
CHROMA_COLLECTION_CV=cv_chunks

# --- OpenAI (LLM + embeddings) ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0
LLM_SEED=42
LLM_MAX_RETRIES=3

# --- Google Cloud Speech-to-Text (streaming gRPC) ---
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-credentials.json
STT_LANGUAGE_CODE=en-US
STT_SAMPLE_RATE_HZ=16000
STT_MODEL=latest_long

# --- Firebase (role-based auth: interviewer / candidate) ---
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-web-api-key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-adminsdk.json

# --- WebRTC ---
STUN_URLS=stun:stun.l.google.com:19302
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Frontend (build-time) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000
